      "prompt": "La profesora ___ explicó la regla a Tomás.",
      "options": [
        "lo",
        "la",
        "le",
        "se"
      ],
      "correct": 2,
      "explanation": "Tomás receives the explanation: le explicó (to him).",
      "optionNotes": [
        "Lo means “him” or “it”, not “to him”.",
        "La means “her” or “it”.",
        null,
        "Se is reflexive here; the teacher explains something to Tomás."

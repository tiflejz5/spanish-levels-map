      "prompt": "No hay ___ en la oficina. (nobody)",
      "options": [
        "alguien",
        "nadie",
        "nada",
        "nunca"
      ],
      "correct": 1,
      "explanation": "Nobody = nadie; after no, Spanish uses the negative word.",
      "optionNotes": [
        "Alguien means “somebody”.",
        null,
        "Nada means “nothing”.",
        "Nunca means “never”."
      ]
    },

      "type": "multiple-choice",
      "kind": "form",
      "prompt": "La fiesta ___ en casa de Rosa.",
      "options": [
        "está",
        "hay",
        "es",
        "estás"
      ],
      "correct": 2,
      "explanation": "Where an event takes place uses ser: la fiesta es en casa de Rosa.",
      "optionNotes": [
        "Events take ser for their place.",
        "Hay would need un / una (hay una fiesta).",
        null,
        "Estás is for tú."

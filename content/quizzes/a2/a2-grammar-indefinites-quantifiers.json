      "type": "multiple-choice",
      "kind": "form",
      "prompt": "¿Tienes ___ libro de cocina?",
      "options": [
        "alguno",
        "algún",
        "algo",
        "alguien"
      ],
      "correct": 1,
      "explanation": "Before a masculine noun, alguno loses the -o: algún libro.",
      "optionNotes": [
        "Before a masculine noun, alguno becomes algún.",
        null,
        "Algo is not used before a noun.",
        "Alguien means “somebody”."
